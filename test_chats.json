{
  "meta": {
    "note": "SYNTHETIC test set. Names and phone numbers are fake. Expected outputs are hand-labelled; review them against your own judgement before trusting them.",
    "reference_date": "2026-10-13",
    "reference_weekday": "Tuesday",
    "schema": {
      "customer": "string|null",
      "phone": "string|null (10 digits, no +91 or spaces)",
      "items": "[{name, qty (number|null), unit (kg|pcs|litre|box|null), notes (string|null)}]",
      "delivery_date": "YYYY-MM-DD|null",
      "delivery_time": "HH:MM | morning | afternoon | evening | lunch | null",
      "amount": "number|null (final agreed total in INR)",
      "paid": "number (0 if nothing paid)",
      "status": "confirmed | tentative | cancelled",
      "needs_review": "boolean (true if info is missing or ambiguous)"
    },
    "rules": [
      "Use the FINAL state of the order if the customer changes or removes things mid-chat.",
      "Normalize dozens to pcs (1 dozen = 12 pcs).",
      "Resolve relative dates (kal, parso, tomorrow, Saturday) from the reference date. Weekday names mean the next upcoming one.",
      "Never invent values. Use null and set needs_review to true when something is missing or ambiguous."
    ]
  },
